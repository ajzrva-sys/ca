{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-team.recipe_proposal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recipe_id", "digest", "observed_at", "observation_count", "definition", "source_evidence_ids", "observed_outcomes", "summary"],
  "properties": {
    "schema": {"const": "codex-team.recipe_proposal.v1"},
    "recipe_id": {"$ref": "#/$defs/id"},
    "digest": {"$ref": "#/$defs/sha256"},
    "observed_at": {"type": "string", "format": "date-time"},
    "observation_count": {"type": "integer", "minimum": 1},
    "definition": {"$ref": "#/$defs/definition"},
    "source_evidence_ids": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 192, "pattern": "^[A-Za-z0-9_.:/-]+$"}},
    "observed_outcomes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/outcome"}},
    "summary": {"type": "string", "minLength": 1, "maxLength": 512}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "disposition", "evidence_hash"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "disposition": {"const": "passed"},
        "evidence_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "applicability", "limits", "safety_classification"],
      "properties": {
        "commands": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/command"}},
        "applicability": {"$ref": "#/$defs/applicability"},
        "limits": {"$ref": "#/$defs/limits"},
        "safety_classification": {"const": "evidence_only_no_product_writes_no_network"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program", "args", "cwd", "timeout_seconds", "kind", "failure_policy", "expected_exit", "tags", "source"],
      "properties": {
        "id": {"type": "string", "maxLength": 256},
        "program": {"type": "string", "minLength": 1, "maxLength": 128},
        "args": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 4096}},
        "cwd": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 4096}]},
        "timeout_seconds": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 900}]},
        "kind": {"enum": ["build", "test", "lint", "search", "git", "smoke", "unknown"]},
        "failure_policy": {"enum": ["stop", "collect"]},
        "expected_exit": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
        "tags": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}},
        "source": {"type": "string", "maxLength": 256}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "required_files", "lockfile_format", "toolchain_family", "manifest_capabilities", "task_kinds", "evidence_only"],
      "properties": {
        "ecosystem": {"enum": ["cargo", "swift", "node", "python", "generic"]},
        "required_files": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 4096}},
        "lockfile_format": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]},
        "toolchain_family": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "maxLength": 64}},
        "manifest_capabilities": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}},
        "task_kinds": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 64}},
        "evidence_only": {"const": true}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_commands", "max_command_seconds", "max_total_seconds"],
      "properties": {
        "max_commands": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_command_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "max_total_seconds": {"type": "integer", "minimum": 1, "maximum": 1200}
      }
    }
  }
}
