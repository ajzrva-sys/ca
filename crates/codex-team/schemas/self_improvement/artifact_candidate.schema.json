{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-team.local/schemas/self_improvement/artifact_candidate.schema.json",
  "title": "ArtifactCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "objective_id", "evaluation_plan_id", "author_provider", "author_model", "kind", "content_tree_sha256", "baseline_revisions", "source_evidence_ids", "applicability", "limits", "created_at", "digest"],
  "properties": {
    "schema": {"const": "codex-team.artifact_candidate.v1"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "objective_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "evaluation_plan_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "author_provider": {"type": "string", "minLength": 1, "maxLength": 80},
    "author_model": {"type": "string", "minLength": 1, "maxLength": 160},
    "kind": {"enum": ["memory", "skill", "role_prompt", "routing", "recipe", "source"]},
    "content_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_revisions": {"type": "array", "items": {"type": "string"}},
    "source_evidence_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string"}},
    "applicability": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "maxLength": 160}},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_files", "maximum_package_bytes", "maximum_prompt_bytes", "timeout_seconds", "network_allowed", "source_changes_allowed"],
      "properties": {
        "maximum_files": {"type": "integer", "minimum": 1, "maximum": 64},
        "maximum_package_bytes": {"type": "integer", "maximum": 8388608},
        "maximum_prompt_bytes": {"type": "integer", "maximum": 65536},
        "timeout_seconds": {"type": "integer", "maximum": 900},
        "network_allowed": {"const": false},
        "source_changes_allowed": {"const": false}
      }
    },
    "created_at": {"type": "string"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
