{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-team.local/schemas/self_improvement/evaluation_plan.schema.json",
  "title": "EvaluationPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "plan_id", "objective_id", "baseline_revisions", "cases",
    "deterministic_acceptance", "available_non_author_judges", "frozen_at", "digest"
  ],
  "properties": {
    "schema": {"const": "codex-team.evaluation_plan.v1"},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "objective_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "baseline_revisions": {"type": "array", "items": {"type": "string"}},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "input_evidence_ids", "repository_fingerprint", "route", "grants_digest", "acceptance_contract_digest", "adversarial"],
        "properties": {
          "case_id": {"type": "string"},
          "input_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "repository_fingerprint": {"type": "string"},
          "route": {"type": "string"},
          "grants_digest": {"type": "string"},
          "acceptance_contract_digest": {"type": "string"},
          "adversarial": {"type": "boolean"}
        }
      }
    },
    "deterministic_acceptance": {"type": "array", "items": {"type": "string"}},
    "available_non_author_judges": {"type": "array", "items": {"type": "string"}},
    "frozen_at": {"type": "string"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
