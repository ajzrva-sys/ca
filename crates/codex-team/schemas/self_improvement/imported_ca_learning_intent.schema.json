{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-team.local/schemas/self_improvement/imported_ca_learning_intent.schema.json",
  "title": "ImportedCaLearningIntentV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "import_id", "profile_fingerprint", "ca_intent_digest", "kind", "trigger", "evidence", "total_messages", "total_bytes", "skipped_sessions", "created_at", "digest"],
  "properties": {
    "schema": {"const": "codex-team.imported_ca_learning_intent.v1"},
    "import_id": {"type": "string", "maxLength": 160},
    "profile_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ca_intent_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"enum": ["dream", "distill"]},
    "trigger": {"enum": ["automatic", "manual"]},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object"}},
    "total_messages": {"type": "integer", "minimum": 1, "maximum": 2048},
    "total_bytes": {"type": "integer", "maximum": 262144},
    "skipped_sessions": {"type": "integer"},
    "created_at": {"type": "string"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
