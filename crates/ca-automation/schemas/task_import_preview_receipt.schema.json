{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-team.task_import_preview.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mutation_performed",
    "valid",
    "repository_revision",
    "current_head",
    "import_digest",
    "task",
    "validation"
  ],
  "properties": {
    "schema": {"const": "codex-team.task_import_preview.v1"},
    "mutation_performed": {"const": false},
    "valid": {"type": "boolean"},
    "repository_revision": {"$ref": "#/$defs/sha256"},
    "current_head": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
      ]
    },
    "import_digest": {"$ref": "#/$defs/sha256"},
    "task": {"$ref": "#/$defs/taskSummary"},
    "validation": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "base_head",
        "task_id",
        "title",
        "kind",
        "objective",
        "why_unblocks_progress",
        "allowed_files",
        "read_only_files",
        "forbidden_actions",
        "steps",
        "acceptance_criteria",
        "verification_commands",
        "stop_conditions",
        "discovery_budget",
        "estimated_minutes"
      ],
      "properties": {
        "source": {"type": "string"},
        "base_head": {"type": "string"},
        "task_id": {"type": "string"},
        "title": {"type": "string"},
        "kind": {"type": "string"},
        "objective": {"type": "string"},
        "why_unblocks_progress": {"type": "string"},
        "allowed_files": {"type": "array", "items": {"type": "string"}},
        "read_only_files": {"type": "array", "items": {"type": "string"}},
        "forbidden_actions": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"type": "string"}},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "verification_commands": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "items": {"type": "string"}},
        "discovery_budget": {"type": "string"},
        "estimated_minutes": {"type": "integer"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "field", "message"],
      "properties": {
        "code": {"type": "string"},
        "field": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
