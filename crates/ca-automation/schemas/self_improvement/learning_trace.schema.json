{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-team.local/schemas/self_improvement/learning_trace.schema.json",
  "title": "LearningTraceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "trace_id", "provider", "model", "role", "prompt", "response",
    "tool_events", "task_identity", "repository_fingerprint", "acceptance_evidence_ids",
    "timing", "usage", "outcome", "core_revision", "overlay_revision", "created_at", "digest"
  ],
  "properties": {
    "schema": {"const": "codex-team.learning_trace.v1"},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "provider": {"type": "string", "maxLength": 80},
    "model": {"type": "string", "maxLength": 160},
    "role": {"type": "string", "maxLength": 80},
    "prompt": {"type": "string", "maxLength": 262200},
    "response": {"type": "string", "maxLength": 262200},
    "tool_events": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
    "task_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acceptance_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at", "finished_at", "elapsed_millis"],
      "properties": {
        "started_at": {"type": "string"}, "finished_at": {"type": "string"},
        "elapsed_millis": {"type": "integer", "minimum": 0}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "estimated_microusd"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_microusd": {"type": "integer", "minimum": 0}
      }
    },
    "outcome": {"type": "string"},
    "core_revision": {"type": "string"},
    "overlay_revision": {"type": "string"},
    "created_at": {"type": "string"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
