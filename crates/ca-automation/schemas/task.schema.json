
{
  "type": "object",
  "required": [
    "task_id",
    "parent_task",
    "status",
    "priority",
    "review_tier",
    "automation_level",
    "mechanistic_actions",
    "delegation_policy",
    "dependencies",
    "title",
    "kind",
    "objective",
    "why_unblocks_progress",
    "allowed_files",
    "read_only_files",
    "forbidden_actions",
    "exact_steps",
    "success_criteria",
    "tests_to_run",
    "stop_conditions",
    "discovery_budget",
    "estimated_minutes",
    "requires_network"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {"type": "string"},
    "parent_task": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["approved", "blocked", "done", "rejected", "pending"]},
    "priority": {"type": "string"},
    "review_tier": {"type": "string", "enum": ["rust_only", "auto_accept_if_verified", "ai_review_on_failure", "always_ai_review", "human_review"]},
    "automation_level": {"type": "string", "enum": ["rust_only", "rust_patch", "ai_worker_rust_review", "ai_worker_ai_review", "planning_only"]},
    "mechanistic_actions": {"type": "array", "maxItems": 8, "items": {"$ref": "mechanistic_action.schema.json"}},
    "delegation_policy": {"type": "string", "enum": ["legacy", "prefer", "require", "deny"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "title": {"type": "string"},
    "kind": {"type": "string", "enum": ["implementation", "repair", "verification", "discovery", "documentation", "setup"]},
    "objective": {"type": "string"},
    "why_unblocks_progress": {"type": "string"},
    "allowed_files": {"type": "array", "items": {"type": "string"}},
    "read_only_files": {"type": "array", "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "exact_steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "success_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "tests_to_run": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "discovery_budget": {"type": "string"},
    "estimated_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
    "requires_network": {"type": "boolean"}
  }
}
